<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>activity_indicator_driver</name>
  <version>0.0.0</version>
  <description>Freya neopixel activity indicator driver using the I2C to Neopixel Driver Board</description>
  <maintainer email="stanislav.svediroh@vut.cz">Stanislav Svědiroh</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>activity_indicator_msgs</exec_depend>
  <!-- board, busio, rainbowio (Adafruit Blinka) and adafruit_seesaw: the LED board over I2C -->
  <exec_depend>python3-adafruit-blinka-pip</exec_depend>
  <!-- not in the official rosdep database: bmr_system/deps/rosdep.yaml -->
  <exec_depend>python3-adafruit-circuitpython-seesaw-pip</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
